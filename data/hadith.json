  },
  "justice": {
    "text": "إِنَّ الْمُقْسِطِينَ عِنْدَ اللَّهِ عَلَى مَنَابِرَ مِنْ نُورٍ",
    "url": "https://sunnah.com/muslim:1827",
    "collection": "مسلم",
