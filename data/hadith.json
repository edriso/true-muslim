    "narrator": "أبو هريرة",
    "excerpt": true,
    "checkedAt": "2026-09-05"
  },
  "excellence": {
    "text": "إِنَّ اللَّهَ كَتَبَ الإِحْسَانَ عَلَى كُلِّ شَىْءٍ",
