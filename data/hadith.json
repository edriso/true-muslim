    "checkedAt": "2026-09-05"
  },
  "neighbors": {
    "text": "مَا زَالَ يُوصِينِي جِبْرِيلُ بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ",
